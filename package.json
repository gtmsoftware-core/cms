{
  "name": "gtmsoftware-cms",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "validate:arch": "node scripts/validate-architecture.mjs",
    "graph:arch": "depcruise apps/cms/src packages/sdk/src --config .dependency-cruiser.cjs --output-type dot | dot -T svg > architecture.svg"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
