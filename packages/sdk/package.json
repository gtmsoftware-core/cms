{
  "name": "@gtmsoftware-core/cms-sdk",
  "version": "0.3.0",
  "description": "Contrato p\u00fablico entre o CMS e os sites dos clientes.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./next": "./src/next/index.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./next": {
        "types": "./dist/next/index.d.ts",
        "default": "./dist/next/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepack": "tsup"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "next": ">=16"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "next": "16.4.3",
    "tsup": "^9.0.0"
  }
}
