# Diretório do banco PGlite (relativo a apps/cms).
PGLITE_DATA_DIR=.data/pglite
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Chave AES-256-GCM dos segredos de webhook. Gere com: openssl rand -base64 32
# Trocar esta chave invalida os segredos já salvos (gere novos no admin).
WEBHOOK_ENCRYPTION_KEY=
# Token da rota /api/cron/webhooks (Authorization: Bearer ...). Gere com: openssl rand -hex 32
CRON_SECRET=
# Mídia: sem as variáveis R2_*, os arquivos ficam nesta pasta e o CMS os serve em /media/...
MEDIA_LOCAL_DIR=.data/media
# Cloudflare R2 (produção). Configure todas ou nenhuma.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://media.seudominio.com
